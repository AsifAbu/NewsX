// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  MODERATOR
  ADMIN
}

enum NewsStatus {
  DRAFT
  PENDING
  PUBLISHED
  REJECTED
  DELETED
  HIDDEN
}

enum CommentStatus {
  VISIBLE
  REMOVED
}

enum ApprovalDecision {
  APPROVED
  REJECTED
}

model User {
  id                     String   @id @default(cuid())
  email                  String   @unique
  phone                  String?
  passwordHash           String
  name                   String
  role                   Role     @default(USER)
  avatarUrl              String?
  // Simple scalar list for MVP (no join table) — category ids the user follows
  interestedCategoryIds  String[] @default([])
  // Set by an Admin via the Deactivate dialog; null = active. Can be a future
  // timestamp (deactivation takes effect at next login after that moment) or
  // now/past (effective immediately). No background job needed — enforced
  // on-demand in the auth check.
  deactivatedAt          DateTime?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  news          News[]         @relation("NewsAuthor")
  archivedNews  News[]         @relation("NewsArchivedBy")
  comments      Comment[]
  bookmarks     Bookmark[]
  approvalLogs  ApprovalLog[]  @relation("ApprovalAdmin")
  reports       Report[]       @relation("Reporter")
  notifications Notification[]
}

model Notification {
  id        String   @id @default(cuid())
  message   String
  link      String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id])

  @@index([userId, isRead])
}

model Category {
  id   String @id @default(cuid())
  name String @unique

  news News[]
}

model News {
  id              String     @id @default(cuid())
  title           String
  slug            String     @unique
  body            String
  imageUrl        String?
  sourceUrl       String?
  // Public "Source: X" credit line on News Details — editor-typed when
  // writing manually, auto-filled (editable) from the pulled page's
  // og:site_name when using "Pull" from a link. Not the internal author.
  newsSource      String?
  status          NewsStatus @default(DRAFT)
  rejectionReason String?
  viewCount       Int        @default(0)
  publishedAt     DateTime?
  // Set when an Admin moves status to DELETED or HIDDEN (the Archive page's
  // "date of operation"); cleared back to null on restore to PUBLISHED.
  archivedAt      DateTime?
  archivedById    String?
  archivedBy      User?      @relation("NewsArchivedBy", fields: [archivedById], references: [id])
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  authorId   String
  author     User       @relation("NewsAuthor", fields: [authorId], references: [id])
  categories Category[]

  comments     Comment[]
  bookmarks    Bookmark[]
  approvalLogs ApprovalLog[]

  @@index([status, publishedAt])
  @@index([viewCount])
}

model Comment {
  id        String        @id @default(cuid())
  body      String
  status    CommentStatus @default(VISIBLE)
  createdAt DateTime      @default(now())

  newsId String
  news   News   @relation(fields: [newsId], references: [id])
  userId String
  user   User   @relation(fields: [userId], references: [id])

  reports Report[]

  @@index([newsId])
}

// A comment's "reported" state is derived from whether it has any Report
// rows (see `reports: { some: {} }` queries) — not duplicated as a status
// flag on Comment, so there's one source of truth.
model Report {
  id        String   @id @default(cuid())
  reason    String?
  createdAt DateTime @default(now())

  commentId  String
  comment    Comment @relation(fields: [commentId], references: [id])
  reporterId String
  reporter   User    @relation("Reporter", fields: [reporterId], references: [id])
}

model Bookmark {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id])
  newsId String
  news   News   @relation(fields: [newsId], references: [id])

  @@unique([userId, newsId])
}

model ApprovalLog {
  id        String           @id @default(cuid())
  decision  ApprovalDecision
  reason    String?
  decidedAt DateTime         @default(now())

  newsId  String
  news    News   @relation(fields: [newsId], references: [id])
  adminId String
  admin   User   @relation("ApprovalAdmin", fields: [adminId], references: [id])
}
