// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  MODERATOR
  ADMIN
}

enum NewsStatus {
  DRAFT
  PENDING
  PUBLISHED
  REJECTED
}

enum CommentStatus {
  VISIBLE
  REPORTED
  REMOVED
}

enum ApprovalDecision {
  APPROVED
  REJECTED
}

model User {
  id                     String   @id @default(cuid())
  email                  String   @unique
  passwordHash           String
  name                   String
  role                   Role     @default(USER)
  avatarUrl              String?
  // Simple scalar list for MVP (no join table) — category ids the user follows
  interestedCategoryIds  String[] @default([])
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  news         News[]        @relation("NewsAuthor")
  comments     Comment[]
  bookmarks    Bookmark[]
  approvalLogs ApprovalLog[] @relation("ApprovalAdmin")
}

model Category {
  id   String @id @default(cuid())
  name String @unique

  news News[]
}

model News {
  id              String     @id @default(cuid())
  title           String
  slug            String     @unique
  body            String
  imageUrl        String?
  status          NewsStatus @default(DRAFT)
  rejectionReason String?
  viewCount       Int        @default(0)
  publishedAt     DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  authorId   String
  author     User     @relation("NewsAuthor", fields: [authorId], references: [id])
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  comments     Comment[]
  bookmarks    Bookmark[]
  approvalLogs ApprovalLog[]

  @@index([status, publishedAt])
  @@index([viewCount])
}

model Comment {
  id        String        @id @default(cuid())
  body      String
  status    CommentStatus @default(VISIBLE)
  createdAt DateTime      @default(now())

  newsId String
  news   News   @relation(fields: [newsId], references: [id])
  userId String
  user   User   @relation(fields: [userId], references: [id])

  @@index([newsId])
}

model Bookmark {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id])
  newsId String
  news   News   @relation(fields: [newsId], references: [id])

  @@unique([userId, newsId])
}

model ApprovalLog {
  id        String           @id @default(cuid())
  decision  ApprovalDecision
  reason    String?
  decidedAt DateTime         @default(now())

  newsId  String
  news    News   @relation(fields: [newsId], references: [id])
  adminId String
  admin   User   @relation("ApprovalAdmin", fields: [adminId], references: [id])
}
